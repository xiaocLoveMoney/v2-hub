# 部署用 .env 模板（compose.deploy.yml，Ruling-109）。生成：bash init_env.sh deploy.env.example .env
# 留空的 *_PASSWORD / *_KEY 由 init_env.sh 填随机值；.env 只留在服务器上，权限 600，不入库（Ruling-2）。

# 站点域名：解析到本机，Caddy 自动申请 HTTPS 证书；用户端在根路径，管理端在 /admin/（Ruling-61）
HUB_DOMAIN=portal.example.com

# 镜像：默认 Docker Hub；国内拉不动可换 ghcr.io/xiaoclovemoney。标签 latest = 最新版本，也可固定为 v0.24 这样的版本号
HUB_IMAGE_REGISTRY=docker.io/xiaoclux
HUB_IMAGE_TAG=latest

POSTGRES_USER=hub
POSTGRES_PASSWORD=
POSTGRES_DB=v2hub

MINIO_ROOT_USER=hubminio
MINIO_ROOT_PASSWORD=
# hub-server 上传公告 / 教程图片用的 MinIO 账号，只能往桶 uploads 写入（Ruling-89），由 init 容器建好
HUB_UPLOAD_USER=hub-upload
HUB_UPLOAD_PASSWORD=

# 加密主密钥（Base64 的 32 字节，docs/03 §4.3）：加密存库的两步验证、SSH 凭据、落地参数等都靠它，丢了无法解密，务必另行备份
HUB_ENCRYPTION_KEY=

# —— 以下可选，不填则对应功能不可用 ——
# 邮件（注册验证码、找回密码、到期提醒等，docs/03 §5.7）：HUB_SMTP_HOST 或 HUB_SMTP_FROM 留空 = 邮件不可用
# HUB_SMTP_HOST=smtp.example.com
# HUB_SMTP_PORT=587
# HUB_SMTP_USERNAME=
# HUB_SMTP_PASSWORD=
# HUB_SMTP_FROM=noreply@example.com
# starttls / tls / none
# HUB_SMTP_TLS=starttls
# 服务器掉线告警走 Telegram（Ruling-42）
# HUB_TELEGRAM_BOT_TOKEN=
# 大陆连通检测与三网延迟用的 Globalping 令牌（Ruling-67），留空按来源 IP 的免费额度
# HUB_GLOBALPING_TOKEN=
