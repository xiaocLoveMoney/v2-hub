# 模板：执行 bash init_env.sh 生成 .env（自动填随机口令）；.env 不入库（Ruling-2）。
# 留空的口令项由 init_env.sh 生成，部署环境请用自己的密钥管理注入。
POSTGRES_USER=hub
POSTGRES_PASSWORD=
POSTGRES_DB=v2hub
POSTGRES_PORT=15432

MINIO_ROOT_USER=hubminio
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

XUI_A_PORT=12053
XUI_B_PORT=12054

# 部署（compose.deploy.yml / Caddy）用
HUB_ADMIN_DOMAIN=admin.example.com
HUB_USER_DOMAIN=my.example.com
IMAGE_TAG=dev
