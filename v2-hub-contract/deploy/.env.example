# 模板：执行 bash init_env.sh 生成 .env（自动填随机密码）；.env 不入库（Ruling-2）。
# 留空的密码项由 init_env.sh 生成，部署环境请用自己的密钥管理注入。
POSTGRES_USER=hub
POSTGRES_PASSWORD=
POSTGRES_DB=v2hub
POSTGRES_PORT=15432

MINIO_ROOT_USER=hubminio
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

XUI_A_PORT=12053
XUI_B_PORT=12054
# IT-14 的托管主机（--profile sshbox）：SSH 端口与面板端口
SSHBOX_SSH_PORT=12222
SSHBOX_PANEL_PORT=12056

# hub-server 加密主密钥（Base64 的 32 字节，docs/03 §4.3）；留空由 init_env.sh 生成
HUB_ENCRYPTION_KEY=

# 部署（compose.deploy.yml / Caddy）用：单域名，管理端在 /admin/（Ruling-61）。生产机的 .env 在 /opt/v2-hub/.env（Ruling-62）
HUB_DOMAIN=portal.example.com

# 邮件（docs/03 §5.7，Ruling-24）：HUB_SMTP_HOST 或 HUB_SMTP_FROM 留空 = 邮件不可用，依赖邮件的功能整体关闭
HUB_SMTP_HOST=
HUB_SMTP_PORT=587
HUB_SMTP_USERNAME=
HUB_SMTP_PASSWORD=
HUB_SMTP_FROM=
# starttls / tls / none
HUB_SMTP_TLS=starttls
# 大陆连通检测用的探测服务（Globalping）令牌（docs/03 §5.20，Ruling-67）：可留空，留空按来源 IP 的免费额度
HUB_GLOBALPING_TOKEN=
# IP 质量检测的数据源 key（docs/03 §5.23，Ruling-82）：都可留空，留空的源在报告里标“未配置”（IP2Location.io 留空按免 key 额度查）
HUB_IPQ_IP2LOCATION_KEY=
HUB_IPQ_IPAPIIS_KEY=
HUB_IPQ_ABUSEIPDB_KEY=
HUB_IPQ_IPQS_KEY=
